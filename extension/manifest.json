{
  "manifest_version": 3,
  "name": "VK Video Mirror",
  "version": "1.0.0",
  "description": "Mirror VK videos horizontally with one click, keeping player controls unchanged. Developed by Kardanio.",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VK Video Mirror — Developed by Kardanio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vk.com/*",
        "*://*.vkvideo.ru/*",
        "*://*.vkvideo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
